# opskeeper — local dev compose (deploy/docker-compose.yml)
#
# Copy to deploy/.env and adjust. Every value below has a sane default in the
# compose file, so the stack also boots with no .env at all — this file just
# covers the handful you'll usually want to set for local development.
#
# This is a LOCAL DEV convenience stack: no TLS, trivial DB password baked into
# the compose file. Do NOT expose it beyond localhost. For production use the
# release package under deploy/install/ instead.

# --- First admin (seeded on first boot; if empty, no admin is created) ---
OPSKEEPER_ADMIN_EMAIL=admin@opskeeper.local
OPSKEEPER_ADMIN_PASSWORD=change-me

# --- JWT signing secret (override the insecure default) ---
OPSKEEPER_JWT_SECRET=change-me-to-a-long-random-string

# --- LLM endpoint (any OpenAI-compatible API; empty key => AI chat is disabled) ---
OPSKEEPER_OPENAI_API_KEY=
OPSKEEPER_OPENAI_MODEL=gpt-4o
# OPSKEEPER_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embedded Grafana (local dev defaults; production install generates random) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# OPSKEEPER_GRAFANA_INTERNAL_URL=http://grafana:3000/grafana
# Leave empty to disable embedded Grafana token bootstrap.
# OPSKEEPER_GRAFANA_BOOTSTRAP_PASSWORD=

# --- Embedding provider for knowledge base / RAG ---
OPSKEEPER_EMBEDDING_PROVIDER=local
OPSKEEPER_EMBEDDING_MODEL=bge-small-zh-v1.5
OPSKEEPER_EMBEDDING_DIM=512
OPSKEEPER_EMBEDDING_API_KEY=
OPSKEEPER_EMBEDDING_BASE_URL=
# Only needed for the search profile: `make compose-up` does not start searxng,
# and nothing else in the stack depends on it. Leave it empty unless you are
# turning web search on.
#
# When you do turn it on, set a verified immutable reference (repo@sha256:...).
# Resolve it with `docker manifest inspect searxng/searxng:<tag>` and record the
# digest resolution date. `make compose-search-up` refuses a floating tag.
SEARXNG_IMAGE=

# --- 集群联邦：策略树的投递方式（三选一）---
#
# 策略树是签名的目录，根签完要送到子集群去取。三种形态：
#
#   1) 共享挂载：只配 ARTIFACT_DIR。子集群用 file:// 取。零配置，
#      多数本地多集群部署已经是这个形状。
#   2) 对象存储 / CDN：配 ARTIFACT_DIR + ARTIFACT_BASE_URL +
#      ARTIFACT_MANIFEST。子集群用 https:// 取。
#   3) 什么都不配：可以登记子集群、可以读它们在执行什么，但发出去的版本
#      没有任何节点被通知——这是合法状态，不是配置错误。
#
# 形态 2 的 MANIFEST 不是可选的：根在给出 URL 之前，会先比对自己签的那棵树
# 与存储里那份的摘要，对不上就不给 URL。MANIFEST 就是它知道存储里有什么的
# 途径——由你自己的发布步骤（CI / 对象存储上传）在上传之后写一行
#   {"<集群>-v<版本>.tar.gz": "<sha256>"}
# 每次投递都会重读，不缓存：发布步骤在带外跑，启动时读一次就意味着整个进程
# 生命周期都拿着一份过期快照。
#
# 摘要不一致是**冲突**不是「还没发布」：重试多少次都不会变，所以它会让发布
# 停下来等人说话，而不是一直转。
OPSKEEPER_FEDERATION_ARTIFACT_DIR=
# 集群与版本名在子集群那侧的路径；只在两边拼写不同时才需要（容器挂载、chroot、
# 运维选了另一条 NFS 路径）。留空 = 子集群按根写的位置读。
OPSKEEPER_FEDERATION_ARTIFACT_PREFIX=
# 存储根地址。必须写全 scheme 与 host；"example.com/x"（没有 scheme）会在启动时
# 直接报错，而不是被猜成 https——那等于把签名策略树发到一个没人选过的地址。
OPSKEEPER_FEDERATION_ARTIFACT_BASE_URL=
# 上面那个 store 的摘要清单路径，JSON，见上面的说明。
OPSKEEPER_FEDERATION_ARTIFACT_MANIFEST=
# 留空 = 只读形状：这个根知道 store 里有什么，并且拒绝为任何它不知道的东西
# 指 URL（那正是上面这条路径的安全属性）。填上 = 这个根自己负责把签名树放进
# store，于是一次下发不再停在 ErrNotPublished，直到有人用命令行上传为止。
# 摘要清单会被发布端写入（可写才算发布成功），所以这条路径要对进程可写。
OPSKEEPER_FEDERATION_ARTIFACT_STORE_URL=
# 上面那个 store 的 bearer token。**没有默认值**：把签名策略树放进一个谁都能
# 写的 store 不是部署形态，是一个带 URL 的泄漏，所以缺它就直接拒绝启动。
OPSKEEPER_FEDERATION_ARTIFACT_STORE_TOKEN=
