# opskeeper + AgentTeams demo 环境变量模板（仅供仓库根 docker-compose.yml）
#
# 用法：
#   cp .env.demo.example .env
#   # 按需修改密码 / escalation URL
#   docker compose --env-file .env up -d --build
#
# 注意：仓库根 `.env.example` 服务于 deploy/docker-compose.yml（MySQL 本地开发栈），
# 本文件服务对象是仓库根 `docker-compose.yml`（pgvector + AgentTeams + Element Web demo）。
#
# 所有变量在 docker-compose.yml 中都有默认值，缺省也能起，仅密码 / secret 是 placeholder。

# --- PostgreSQL ---
POSTGRES_USER=opskeeper
POSTGRES_PASSWORD=opskeeper
POSTGRES_HOST_PORT=5432
OPSKEEPER_DB=opskeeper
OPSKEEPER_DB_PASSWORD=opskeeper
OPSKEEPER_AGENTTEAMS_DB=agentteams

# --- Redis ---
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# --- opskeeper HTTP / metrics ---
OPSKEEPER_HTTP_PORT=8080
OPSKEEPER_METRICS_PORT=9100

# --- T16 case-owned CPU fixture ---
# 生成方式：openssl rand -hex 32；不要提交真实 token
# HOST_FIXTURE_TOKEN=
HOST_FIXTURE_PORT=8091

# --- Knowledge RAG ---
# qdrant 服务已在 compose 内启动；embedding key 配置后 SOP/postmortem 向量写入可用
QDRANT_HOST_PORT=6333
OPSKEEPER_EMBEDDING_API_KEY=
OPSKEEPER_EMBEDDING_BASE_URL=
OPSKEEPER_EMBEDDING_MODEL=

# --- OTLP 可观测 ---
# 指向 Tempo / LoongSuite 等 OTLP HTTP collector 的 host:port；未部署 collector 时可留空
OPSKEEPER_OTEL_ENDPOINT=tempo:4318

# --- opskeeper auth / JWT ---
OPSKEEPER_JWT_SECRET=change-me-to-a-long-random-string
OPSKEEPER_JWT_ACCESS_TTL=15m
OPSKEEPER_JWT_REFRESH_TTL=168h

# --- opskeeper 默认管理员（首次启动播种，后续修改走 UI）---
OPSKEEPER_ADMIN_EMAIL=admin@opskeeper.local
OPSKEEPER_ADMIN_PASSWORD=change-me-on-first-login

# --- HITL 升级通道 ---
# demo 默认指向 element-web 容器内 80 端口；线上请改为外网可达的飞书/钉钉/PagerDuty webhook
OPSKEEPER_HITL_ESCALATION_URL=http://element-web:80
OPSKEEPER_HITL_INTERVAL=1m
OPSKEEPER_HITL_TIMEOUT=15m

# --- AgentTeams 控制器（占位镜像） ---
AGENTTEAMS_CONTROLLER_IMAGE=ghcr.io/agentteams/controller:dev
AGENTTEAMS_CONTROLLER_PORT=8090

# --- Element Web ---
ELEMENT_WEB_PORT=8081
