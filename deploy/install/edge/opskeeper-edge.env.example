# opskeeper-edge environment file - rendered by install-edge.sh to
# /etc/opskeeper-edge/opskeeper-edge.env. The systemd unit reads this via
# EnvironmentFile=. The opskeeper-edge binary consumes these env vars directly
# (see core/floor/config/config.go: OPSKEEPER_EDGE_CLOUD_ADDR / _ACCESS_KEY /
# _SECRET_KEY).

OPSKEEPER_EDGE_CLOUD_ADDR=__CLOUD_ADDR__
OPSKEEPER_EDGE_ACCESS_KEY=__ACCESS_KEY__
OPSKEEPER_EDGE_SECRET_KEY=__SECRET_KEY__
OPSKEEPER_EDGE_COLLECTOR_MODE=auto
OPSKEEPER_EDGE_SCRAPE_CONFIG_FILE=/etc/opskeeper-edge/scrape.yaml
OPSKEEPER_EDGE_COLLECTOR_INTERVAL=10s

# ---- restart_service (the node's only mutating capability) ------------------
# true  = the node answers "restarted" without touching a service, and says
#         so in its own response (mocked: true). This is the shipped posture:
#         an edge that restarts services because nobody read a release note is
#         a worse failure than one that pretends.
# false = the node really runs `systemctl restart <unit>`, still only for the
#         allow-listed units below, still only after the cloud-side reviewer
#         approved the proposal.
OPSKEEPER_EDGE_RESTART_SERVICE_MOCKED=true
# Empty means "the shipped narrow list" (nginx redis prometheus loki tempo
# grafana mysql opskeeper). Set it to narrow or widen deliberately.
# OPSKEEPER_EDGE_RESTART_SERVICE_ALLOWED_UNITS=nginx,redis
OPSKEEPER_EDGE_RESTART_SERVICE_SYSTEMCTL=systemctl

# ---- Node AI agent --------------------------------------------------------
# Absolute path to the `pig` binary this installer just placed and verified.
# It is absolute on purpose: the default is `pig` off PATH, and a node whose
# PATH happens to contain some other pig — an operator's own experiment, a
# stale symlink, a leftover container layer — would silently run a different
# agent from the one this release shipped and pinned. The path inside
# /usr/local/lib/opskeeper-edge is versioned by the bundle, not by PATH.
OPSKEEPER_EDGE_AGENT_BIN=/usr/local/lib/opskeeper-edge/pig

# Where the node's agent reads its provider configuration from. It is NOT
# the agent's working directory: the working directory is the plugin bundle
# root, and the agent resolves a relative configuration path against it, so
# leaving this unset would put a credential inside signed plugin content on
# any host whose service manager does not set HOME.
OPSKEEPER_EDGE_AGENT_CONFIG_DIR=/var/lib/opskeeper-edge/agent-home

# The model endpoint this node's agent talks to, and the credential for it.
# If you set either one, set both: an endpoint with no credential produces a
# node that starts, loads its plugins and answers nothing, and a credential
# with no endpoint sends the token somewhere nobody chose. The node refuses
# to start its agent in that case and says which one it was. Set neither and
# the manager supplies the endpoint instead — see below.
#
# The endpoint is an OpenAI-compatible root — the manager's gateway. The
# credential is never written to disk: the node's agent configuration names
# this variable, and the agent expands the reference at authentication time,
# so rotating the token is restarting this service on each host.
#
# Leaving BOTH of these empty is a supported deployment, and it is the one to
# prefer: the manager then names the endpoint and the model on the heartbeat
# the node already sends, and the node adopts them when its own environment is
# silent. What you set here is a host-specific override — if you set it, it
# wins over the manager, permanently and on every beat, which is the right
# answer for a host that must not follow the cluster default.
OPSKEEPER_EDGE_AGENT_BASE_URL=
OPSKEEPER_EDGE_AGENT_TOKEN=
# Pins the model slug the endpoint serves, so the node and the manager agree
# on which model answers. Empty lets the endpoint's default stand.
OPSKEEPER_EDGE_AGENT_MODEL=

# ---- Plugin runtime (ADR-015) ----------------------------------------
# Edge ID is needed by every plugin to inject the `edge_id` label set on
# outbound telemetry. Empty by default — plugins refuse to render config
# until operator sets this (auto-discovered ID will land here in PR-C2).
OPSKEEPER_EDGE_ID=

# ---- Logs plugin (ADR-012) -------------------------------------------
# Off by default. Set ENABLED=true + ENDPOINT=https://<manager>/loki/api/v1/push
# to start shipping journald + file tail logs. AUTH_USER / AUTH_PASS
# default to the tunnel ACCESS_KEY / SECRET_KEY above (data plane and
# control plane share credentials per ADR-014 §决策第 2 条).
OPSKEEPER_EDGE_PLUGIN_LOGS_ENABLED=false
OPSKEEPER_EDGE_PLUGIN_LOGS_ENDPOINT=
# OPSKEEPER_EDGE_PLUGIN_LOGS_AUTH_USER=  # defaults to OPSKEEPER_EDGE_ACCESS_KEY
# OPSKEEPER_EDGE_PLUGIN_LOGS_AUTH_PASS=  # defaults to OPSKEEPER_EDGE_SECRET_KEY
# Spec is JSON; control which sources are tailed.
# OPSKEEPER_EDGE_PLUGIN_LOGS_SPEC_JSON={"file_paths":["/var/log/syslog"]}
