# /etc/agentteams-plugin-manager.env — sourced by systemd unit as EnvironmentFile
# Copy to /etc/agentteams-plugin-manager.env and chmod 0600; secrets must not be world-readable.

# Listen address (host:port). Default: ":8095"  — pick whatever port is free on the host.
PLUGIN_MANAGER_LISTEN=:18095

# SQLite database path. The directory MUST exist and be writable by the service user.
PLUGIN_MANAGER_DB_PATH=/var/lib/agentteams-plugin-manager/db.sqlite

# Where to persist uploaded tarballs. Same permission requirement as DB path.
PLUGIN_MANAGER_STORAGE_PATH=/var/lib/agentteams-plugin-manager/plugins

# Max upload size in MB (default 128). Single plugin tarballs rarely exceed 20 MB.
PLUGIN_MANAGER_MAX_UPLOAD_MB=128

# SA token used by wrapper.js → plugin-manager Bearer auth. Must match the
# AGENTTEAMS_AUTH_TOKEN that the agentteams-controller SA carries.
PLUGIN_MANAGER_SA_TOKEN=replace-me-with-real-sa-token

# QwenPaw worker plugin-manager pushes to. Use the host's mapped port when the
# worker runs in a container (e.g. http://127.0.0.1:17281), or the container DNS
# name when worker runs on the same Docker network (e.g. http://agentteams-worker-lumos:8088).
PLUGIN_MANAGER_WORKER_BASE_URL=http://127.0.0.1:17281

# Worker SA token — usually the same secret as PLUGIN_MANAGER_SA_TOKEN.
PLUGIN_MANAGER_WORKER_SA_TOKEN=replace-me-with-real-sa-token