# Database (default: MySQL)
OPSKEEPER_DB_DIALECT=mysql
OPSKEEPER_DB_DSN=opskeeper:opskeeper@tcp(127.0.0.1:3306)/opskeeper?parseTime=true&charset=utf8mb4&loc=Local

# For SQLite (opt-in, suitable for single-user local dev):
# OPSKEEPER_DB_DIALECT=sqlite
# OPSKEEPER_DB_PATH=./data/opskeeper.db

# Server ports (in-container; nginx fronts these on the host — see ADR-008)
OPSKEEPER_HTTP_ADDR=:8080
OPSKEEPER_METRICS_ADDR=:9100

# nginx-fronted host ports (ADR-008). 443 = HTTPS, 80 = HTTP redirect.
# Set OPSKEEPER_HTTP_REDIRECT_PORT=0 to disable the 80 -> 443 redirect.
OPSKEEPER_HTTP_PORT=443
OPSKEEPER_HTTP_REDIRECT_PORT=80

# --- Frontier broker (upstream singchia/frontier; ADR-007) ---
# Manager dials the broker's service-bound port (40011). Inside docker
# compose use `frontier:40011`; for `make run-opskeeper` against a frontier
# container exposed via the dev compose, use `localhost:40011`.
OPSKEEPER_FRONTIER_ADDR=frontier:40011
OPSKEEPER_FRONTIER_SERVICE_NAME=opskeeper-manager

# Bootstrap admin (cloud only). Seeded on first startup if the email is
# unused. Leave both empty to start with an empty users table (nobody can
# log in until you set these and restart).
OPSKEEPER_ADMIN_EMAIL=admin@opskeeper.local
OPSKEEPER_ADMIN_PASSWORD=change-me-on-first-login

# JWT signing
OPSKEEPER_JWT_SECRET=change-me-to-a-long-random-string
OPSKEEPER_JWT_ACCESS_TTL=15m
OPSKEEPER_JWT_REFRESH_TTL=168h

# OpenAI
OPSKEEPER_OPENAI_API_KEY=
OPSKEEPER_OPENAI_MODEL=gpt-4o
OPSKEEPER_OPENAI_BASE_URL=

# --- Cloud-side Prometheus (ADR-009) ---
# When OPSKEEPER_PROM_ENABLED=true the manager forwards push_prom_samples to
# remote_write, and the AI agent gains a query_promql tool. Leave false
# until you actually deploy a Prom container.
OPSKEEPER_PROM_ENABLED=true
OPSKEEPER_PROM_URL=http://prometheus:9090/prometheus
# Optional exact remote_write endpoint for Prometheus-compatible TSDBs
# (VictoriaMetrics / Mimir / Cortex / Thanos receive). Empty means
# OPSKEEPER_PROM_URL + /api/v1/write.
OPSKEEPER_PROM_REMOTE_WRITE_URL=
# Optional Prometheus-compatible query API root. Empty means OPSKEEPER_PROM_URL.
OPSKEEPER_PROM_QUERY_URL=http://prometheus:9090/prometheus

# --- Built-in host alert thresholds (fast-path HostMetricPoint) ---
OPSKEEPER_ALERT_ENABLED=true
OPSKEEPER_ALERT_COOLDOWN=10m
OPSKEEPER_ALERT_CPU_PERCENT=90
OPSKEEPER_ALERT_MEM_PERCENT=90
OPSKEEPER_ALERT_DISK_USED_PERCENT=90
# 0 disables load1 alerting; set an absolute load threshold if desired.
OPSKEEPER_ALERT_LOAD1=0

# --- Outbound notifications (alerts / scheduled jobs / proactive AIOps) ---
# Disabled by default. Set default channels to any enabled channel names below.
OPSKEEPER_NOTIFY_ENABLED=false
OPSKEEPER_NOTIFY_DEFAULT_CHANNELS=log
OPSKEEPER_NOTIFY_TIMEOUT=10s

# Local dry-run sink. Useful before wiring real external channels.
OPSKEEPER_NOTIFY_LOG_ENABLED=true
OPSKEEPER_NOTIFY_LOG_NAME=log

# Generic JSON webhook. If secret is set, requests carry X-Opskeeper-Signature.
OPSKEEPER_NOTIFY_WEBHOOK_ENABLED=false
OPSKEEPER_NOTIFY_WEBHOOK_NAME=webhook
OPSKEEPER_NOTIFY_WEBHOOK_URL=
OPSKEEPER_NOTIFY_WEBHOOK_SECRET=

# Slack incoming webhook.
OPSKEEPER_NOTIFY_SLACK_ENABLED=false
OPSKEEPER_NOTIFY_SLACK_NAME=slack
OPSKEEPER_NOTIFY_SLACK_WEBHOOK_URL=

# Feishu/Lark custom bot webhook.
OPSKEEPER_NOTIFY_FEISHU_ENABLED=false
OPSKEEPER_NOTIFY_FEISHU_NAME=feishu
OPSKEEPER_NOTIFY_FEISHU_WEBHOOK_URL=
OPSKEEPER_NOTIFY_FEISHU_SECRET=

# DingTalk custom robot webhook.
OPSKEEPER_NOTIFY_DINGTALK_ENABLED=false
OPSKEEPER_NOTIFY_DINGTALK_NAME=dingtalk
OPSKEEPER_NOTIFY_DINGTALK_WEBHOOK_URL=
OPSKEEPER_NOTIFY_DINGTALK_SECRET=

# opskeeper-edge only — dial the broker's edge-bound port (40012, host-mapped to 40012)
OPSKEEPER_EDGE_CLOUD_ADDR=localhost:40012
OPSKEEPER_EDGE_ACCESS_KEY=
OPSKEEPER_EDGE_SECRET_KEY=
OPSKEEPER_EDGE_COLLECTOR_MODE=auto
OPSKEEPER_EDGE_SCRAPE_CONFIG_FILE=/etc/opskeeper-edge/scrape.yaml
OPSKEEPER_EDGE_COLLECTOR_INTERVAL=10s
